<script>
    (function () {
      "use strict";
      if (sessionStorage.getItem("programForcePcViewport") !== "1") {
        return;
      }
      sessionStorage.removeItem("programForcePcViewport");

      function applyProgramPcViewport() {
        document.querySelectorAll('meta[name="viewport"]').forEach(function (el) {
          el.remove();
        });
        var meta = document.createElement("meta");
        meta.name = "viewport";
        meta.content = "width=1200";
        document.head.prepend(meta);
      }

      applyProgramPcViewport();
      document.addEventListener("DOMContentLoaded", applyProgramPcViewport);
    })();

    // URLパラメータからidを取得
    function getScheduleIdFromUrl() {
      var params = new URLSearchParams(window.location.search);
      var id = params.get('id');
      if (id && /^\d+$/.test(id)) {
        return parseInt(id, 10);
      }
      return null;
    }

    // URLパラメータからurlを取得
    function getApiUrlFromUrl() {
      var params = new URLSearchParams(window.location.search);
      return params.get('url');
    }

    // ATXライブラリからAPI・ユーティリティを取得
    // 環境判定は共通ユーティリティ `getApiBaseUrl()` を優先して使用
    var apis = (typeof getApiBaseUrl === "function")
      ? ATX.createApis({ baseUrl: getApiBaseUrl() })
      : ATX.createApis();
    var schedule = apis.schedule;
    var escapeHtml = ATX.escapeHtml;

    // api-hostを取得（metaがあれば優先、なければ getApiBaseUrl()、最終フォールバックは本番ホスト）
    var apiHostMeta = document.querySelector('meta[name="api-host"]');
    var apiHost = null;
    if (apiHostMeta && apiHostMeta.content) {
      apiHost = apiHostMeta.content;
      if (!/^https?:\/\//.test(apiHost)) {
        apiHost = 'https://' + apiHost;
      }
    } else if (typeof getApiBaseUrl === "function") {
      apiHost = getApiBaseUrl();
    } else {
      apiHost = 'https://api.atx.01core.app';
    }

    // 現在の番組表ID
    var scheduleId = getScheduleIdFromUrl();
    // カスタムAPIのURL
    var customApiUrl = getApiUrlFromUrl();

    // パンくずリストを構築
    function renderBreadcrumb(data) {
      var topicPath = document.getElementById('topic_path');
      if (!topicPath) return;

      var dateRange = '';
      if (data && data.start_at && data.end_at) {
        dateRange = '(' + data.start_at + '～' + data.end_at + ')';
      }

      var html = '<ul>';
      html += '<li><a href="/">トップ</a></li>';
      html += '<li class="current">番組表' + dateRange + '</li>';
      html += '</ul>';
      topicPath.innerHTML = html;
    }

    // エラーメッセージを表示
    function showError(message) {
      var content = document.getElementById('content');
      if (!content) return;
      content.innerHTML = '<div class="error"><p>' + escapeHtml(message) + '</p></div>';
    }

    // 番組表が見つからない場合でも.program_block構造を表示
    function renderEmptySchedule(message, data, schedules) {
      var content = document.getElementById('content');
      if (!content) return;

      var html = '';

      // プログラムブロック（上部）
      html += '<div class="program_block">';
      html += '<div class="left_area"><ul>';
      // 番組表がない場合はPDF・印刷ボタンは非表示
      html += '</ul></div>';
      html += '<div class="right_area">';
      html += buildScheduleSelect(schedules, data ? data.id : null, 'up');
      // 前の週・次の週ナビゲーション
      html += '<div class="pagenate_week">';
      html += '<ul>';
      if (data && data.prev_id) {
        html += '<li class="prev"><a class="arrow_l" href="'+location.pathname+'?id=' + data.prev_id + '">前の週</a></li>';
      }
      if (data && data.next_id) {
        html += '<li class="next"><a class="arrow_r" href="'+location.pathname+'?id=' + data.next_id + '">次の週</a></li>';
      }
      html += '</ul>';
      html += '</div>';
      html += '</div>';
      html += '</div>';

      // エラーメッセージ
      html += '<div class="block" id="pageProgram">';
      html += '<div class="error"><p>' + escapeHtml(message) + '</p></div>';
      html += '</div>';

      content.innerHTML = html;
    }

    // 番組表一覧を保持
    var scheduleList = [];

    // 番組表を読み込み
    function loadSchedule(id) {
      var content = document.getElementById('content');
      if (!content) return;

      // URLパラメータにurlがある場合は、そのURLを使用してAPI問い合わせ
      if (customApiUrl) {
        loadScheduleFromUrl(customApiUrl);
        return;
      }

      // /api/schedules?id で番組表一覧と詳細を同時に取得
      // id指定なし: ?id のみで現在の番組表を取得
      // id指定あり: ?id=番組表ID で指定の番組表を取得
      var options = {};
      if (id) {
        options.id = id;
      } else {
        options.id = true; // id パラメータのみ（値なし）で現在の番組表を取得
      }

      schedule.getList(options).then(function(data) {
        scheduleList = data.schedules || [];

        if (data && data.id) {
          renderSchedule(data, scheduleList);
        } else if (data && (data.prev_id || data.next_id)) {
          // idは無いがprev_id/next_idがある場合は.program_block構造を表示
          renderEmptySchedule('番組表が見つかりませんでした。', data, scheduleList);
        } else {
          // dataが無い、またはナビゲーション情報も無い場合
          renderEmptySchedule('番組表が見つかりませんでした。', data, scheduleList);
        }
      }).catch(function(error) {
        console.error('番組表の取得に失敗しました:', error);
        renderEmptySchedule('番組表の取得に失敗しました。', null, scheduleList);
      });
    }

    // 指定されたURLから番組表を読み込み
    function loadScheduleFromUrl(url) {
      var content = document.getElementById('content');
      if (!content) return;

      // urlが相対パスの場合はapiHostを付与
      var fullUrl = url;
      if (url.indexOf('http') !== 0) {
        fullUrl = apiHost + url;
      }

      fetch(fullUrl)
        .then(function(response) {
          if (!response.ok) {
            throw new Error('APIリクエストに失敗しました: ' + response.status);
          }
          return response.json();
        })
        .then(function(data) {
          scheduleList = data.schedules || [];

          if (data && data.id) {
            renderSchedule(data, scheduleList);
          } else if (data && (data.prev_id || data.next_id)) {
            // idは無いがprev_id/next_idがある場合は.program_block構造を表示
            renderEmptySchedule('番組表が見つかりませんでした。', data, scheduleList);
          } else {
            // dataが無い、またはナビゲーション情報も無い場合
            renderEmptySchedule('番組表が見つかりませんでした。', data, scheduleList);
          }
        })
        .catch(function(error) {
          console.error('番組表の取得に失敗しました:', error);
          renderEmptySchedule('番組表の取得に失敗しました: ' + error.message, null, scheduleList);
        });
    }

    // 曜日からクラスを取得
    function getWeekdayClass(weekday, index, total) {
      var cls = '';
      if (weekday === '土') {
        cls = 'bgSat';
      } else if (weekday === '日') {
        cls = 'bgSun';
      } else {
        cls = 'bgGray';
      }
      // 金曜日（週の5番目、0-indexed=4）に境界線
      if (weekday === '金' || index === total - 2) {
        cls += ' bd02';
      }
      return cls;
    }

    // 放送種別からクラスを取得
    function getTypeClass(type) {
      switch (type) {
        case 1: return 'bgPink';    // 新番組
        case 3: return 'bgBlue';  // 最終回
        case 4: return 'bgOrange';  // 放送中止
        default: return '';
      }
    }

    // 時間帯からクラスを取得
    function getTimeClass(timeStr) {
      // "6:00" などの形式から時間を抽出
      var hour = parseInt(timeStr.split(':')[0], 10);
      // 0:00〜5:00は24:00〜29:00と同等に扱う
      if (hour >= 0 && hour < 6) {
        hour += 24;
      }
      if (hour >= 24 && hour < 30) {
        return 'bgYellow time05';  // 24:00（or 0:00）以降30:00未満
      } else if (hour >= 18 && hour < 24) {
        return 'bgYellow time04';  // 18:00以降24:00未満
      } else if (hour >= 12 && hour < 18) {
        return 'bgYellow time02';  // 12:00以降18:00未満
      } else {
        return 'bgYellow';         // デフォルト（6:00以降12:00未満）
      }
    }

    // 時間帯の区切り行かどうかを判定（12:00, 18:00, 24:00/0:00）
    function getRowClass(timeStr) {
      if (timeStr === '12:00' || timeStr === '18:00' || timeStr === '24:00' || timeStr === '0:00') {
        return 'bd';
      }
      return '';
    }

    // 週選択セレクトボックスを構築
    function buildScheduleSelect(schedules, currentId, direction) {
      if (!schedules || schedules.length === 0) return '';

      var arrow = direction === 'up' ? '▼' : '▲';
      var html = '<div class="select_week">';
      html += '<select onchange="location.href=location.pathname+\'?id=\'+this.options[this.selectedIndex].value">';

      // 月ごとにグループ化
      var currentMonth = '';
      for (var i = 0; i < schedules.length; i++) {
        var s = schedules[i];
        if (s.month_jpn !== currentMonth) {
          if (currentMonth !== '') {
            html += '</optgroup>';
          }
          currentMonth = s.month_jpn;
          html += '<optgroup label="' + escapeHtml(currentMonth) + '">';
        }
        var selected = (String(s.id) === String(currentId)) ? ' selected' : '';
        html += '<option value="' + s.id + '"' + selected + '>';
        html += escapeHtml(s.start_at_jpn) + '～' + escapeHtml(s.end_at_jpn);
        html += '</option>';
      }
      if (currentMonth !== '') {
        html += '</optgroup>';
      }

      html += '</select>';
      html += '</div>';
      return html;
    }

    // 番組表をレンダリング
    function renderSchedule(data, schedules) {
      var content = document.getElementById('content');
      if (!content) return;

      // パンくずを更新
      renderBreadcrumb(data);

      // ページタイトルを更新
      document.title = '週間番組表(' + data.start_at + '～' + data.end_at + ') | AT-X';

      var html = '';

      // プログラムブロック（上部）
      html += '<div class="program_block">';
      html += '<div class="left_area"><ul>';
      if (data.pdf_url) {
        html += '<li><a class="btn btn03 program_pdf" href="' + escapeHtml(data.pdf_url) + '" target="_blank">';
        html += '<span>▼の番組表をPDFファイルで表示</span></a></li>';
      }
      html += '<li><a class="btn btn02 program_print" href="#" onclick="window.print(); return false;">';
      html += '<span>▼の番組表を印刷</span></a></li>';
      html += '</ul></div>';
      html += '<div class="right_area">';
      html += buildScheduleSelect(schedules, data.id, 'up');
      // 前の週・次の週ナビゲーション
      html += '<div class="pagenate_week">';
      html += '<ul>';
      if (data.prev_id) {
        html += '<li class="prev"><a class="arrow_l" href="'+location.pathname+'?id=' + data.prev_id + '">前の週</a></li>';
      }
      if (data.next_id) {
        html += '<li class="next"><a class="arrow_r" href="'+location.pathname+'?id=' + data.next_id + '">次の週</a></li>';
      }
      html += '</ul>';
      html += '</div>';
      html += '</div>';
      html += '</div>';

      // 凡例 + テーブル を #pageProgram に内包
      html += '<div class="block" id="pageProgram">';
      html += '<ul class="biko mb10 formstyle">';
      html += '<li class="pink_box"><span>新番組</span></li>';
      html += '<li class="blue_box"><span>最終回</span></li>';
      html += '<li class="orange_box"><span>放送休止</span></li>';
      html += '<li class="ml05">▲ 字幕あり（一部プラットフォーム）</li>';
      html += '</ul>';

      // 日付がない場合
      if (!data.dates || data.dates.length === 0) {
        html += '<div class="error"><p>番組表データがありません。</p></div>';
        html += '</div>'; // #pageProgram を閉じる
        content.innerHTML = html;
        return;
      }

      // ヘッダーテーブル（曜日・日付）
      html += '<table id="timeTableHead"><tbody><tr>';
      for (var i = 0; i < data.dates.length; i++) {
        var date = data.dates[i];
        var cls = getWeekdayClass(date.week_day_jpn, i, data.dates.length);
        html += '<th class="' + cls + '">';
        html += '<span>' + escapeHtml(date.week_day_jpn) + '</span>';
        html += '<em>' + escapeHtml(date.date_jpn) + '</em>';
        html += '</th>';
      }
      html += '</tr></tbody></table>';

      // タイムテーブルがない場合
      if (!data.time_table || data.time_table.length === 0) {
        html += '<div class="error"><p>番組データがありません。</p></div>';
        html += '</div>'; // #pageProgram を閉じる
        content.innerHTML = html;
        return;
      }

      // タイムテーブル
      html += '<table id="timeTable"><tbody>';

      // 日付ごとの残りrowspanを追跡
      var remainingRows = [];
      for (var d = 0; d < data.dates.length; d++) {
        remainingRows.push(0);
      }

      for (var t = 0; t < data.time_table.length; t++) {
        var timeRow = data.time_table[t];
        var rowClass = getRowClass(timeRow.time);
        html += '<tr' + (rowClass ? ' class="' + rowClass + '"' : '') + '>';

        // 左側の時間
        html += '<th class="' + getTimeClass(timeRow.time) + '">' + escapeHtml(timeRow.time) + '</th>';

        // 番組を日付順に並べるためのマップを作成
        var programsByDate = {};
        if (timeRow.programs) {
          for (var p = 0; p < timeRow.programs.length; p++) {
            var prog = timeRow.programs[p];
            programsByDate[prog.date] = prog;
          }
        }

        // 各日付のセルを出力
        for (var d = 0; d < data.dates.length; d++) {
          var dateStr = data.dates[d].date;
          var weekday = data.dates[d].week_day_jpn;

          // まだrowspanが残っている場合はスキップ
          if (remainingRows[d] > 0) {
            remainingRows[d]--;
            continue;
          }

          var prog = programsByDate[dateStr];
          if (prog) {
            var typeClass = getTypeClass(prog.type);
            var bdClass = (weekday === '金') ? ' bd02' : '';
            var rows = prog.rows || 1;

            html += '<td class="' + typeClass + bdClass + '" data-program-id="' + prog.program_id + '"';
            if (rows > 1) {
              html += ' rowspan="' + rows + '"';
              remainingRows[d] = rows - 1;
            }
            html += '>';
            if (prog.program_id) {
              html += '<a href="/program/detail/?id=' + prog.program_id + '">';
            }
            html += escapeHtml(prog.program_title);
            if (prog.episode) {
              html += '　' + escapeHtml(prog.episode);
            }
            if (prog.program_id) {
              html += '</a>';
            }
            html += '</td>';
          } else {
            // 番組がない場合は空セル
            var bdClass = (weekday === '金') ? ' bd02' : '';
            html += '<td class="' + bdClass + '"></td>';
          }
        }

        // 右側の時間
        html += '<th class="' + getTimeClass(timeRow.time) + '">' + escapeHtml(timeRow.time) + '</th>';

        html += '</tr>';
      }

      html += '</tbody></table>';

      // 凡例（下部）
      html += '<ul class="biko mb10 formstyle">';
      html += '<li class="pink_box"><span>新番組</span></li>';
      html += '<li class="blue_box"><span>最終回</span></li>';
      html += '<li class="orange_box"><span>放送休止</span></li>';
      html += '<li class="ml05">▲ 字幕あり（一部プラットフォーム）</li>';
      html += '</ul>';

      // #pageProgram を閉じる
      html += '</div>';

      // プログラムブロック（下部）
      html += '<div class="program_block">';
      html += '<div class="left_area"><ul>';
      if (data.pdf_url) {
        html += '<li><a class="btn btn03 program_pdf" href="' + escapeHtml(data.pdf_url) + '" target="_blank">';
        html += '<span>▲の番組表をPDFファイルで表示</span></a></li>';
      }
      html += '<li><a class="btn btn02 program_print" href="#" onclick="window.print(); return false;">';
      html += '<span>▲の番組表を印刷</span></a></li>';
      html += '</ul></div>';
      html += '<div class="right_area">';
      html += buildScheduleSelect(schedules, data.id, 'down');
      // 前の週・次の週ナビゲーション
      html += '<div class="pagenate_week">';
      html += '<ul>';
      if (data.prev_id) {
        html += '<li class="prev"><a class="arrow_l" href="'+location.pathname+'?id=' + data.prev_id + '">前の週</a></li>';
      }
      if (data.next_id) {
        html += '<li class="next"><a class="arrow_r" href="'+location.pathname+'?id=' + data.next_id + '">次の週</a></li>';
      }
      html += '</ul>';
      html += '</div>';
      html += '</div>';
      html += '</div>';

      content.innerHTML = html;

      // ヘッダー固定処理のセットアップ
      setupTimeTableHeadFixed();
    }

    /**
     * スクロール時のヘッダー固定処理をセットアップ
     */
    function setupTimeTableHeadFixed() {
      var week = document.getElementById('timeTableHead');
      if (!week) return;

      var weekPos = week.getBoundingClientRect().top + window.pageYOffset;
      var fixedClass = 'fixed';

      function handleScroll() {
        var scrollTop = window.pageYOffset || document.documentElement.scrollTop;

        if (scrollTop > weekPos) {
          week.classList.add(fixedClass);
        } else {
          week.classList.remove(fixedClass);
        }
      }

      // 横スクロール対応（画面幅1100px以下の場合）
      function handleHorizontalScroll() {
        if (window.matchMedia('(max-width:1100px)').matches) {
          var scrollLeft = window.pageXOffset || document.documentElement.scrollLeft;
          if (week.classList.contains(fixedClass)) {
            //week.style.left = -scrollLeft + 'px';
          }
        }
      }

      // イベントリスナー登録
      window.addEventListener('scroll', function() {
        handleScroll();
        handleHorizontalScroll();
      });

      // 初回実行
      handleScroll();
    }

    // SP版切り替えボタンのhrefを設定
    function setupViewModeSwitch() {
    }

    // 初期表示
    loadSchedule(scheduleId);

    // SP版切り替えボタンのhref設定
    setupViewModeSwitch();
</script>
