    <article class="main description huge:tw-order-0 tw-order-first tw-mx-auto tw-mb-40 tw-grow tw-basis-[50.6493%] tw-px-15 medium:tw-mb-60 medium:tw-px-20 huge:tw-mb-0 huge:tw-max-w-[1000px] huge:tw-px-0 huge-2:tw-grow-0 tw-max-w-[800px]"
